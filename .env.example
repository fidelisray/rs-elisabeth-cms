APP_NAME=Laravel
APP_ENV=local
BOOTSTRAP_MINIO_SETUP=false
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Disk tunggal untuk SEMUA media konten (upload, konversi WebP, URL API).
# Sama di semua environment. Isi kredensial MINIO_* di bawah agar disk ini berfungsi.
MEDIA_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# RS Geni API & RS MedInfras API
RS_API_BASE_URL=https://latu.rs-elisabeth.com
RS_API_ENABLED=true
RS_API_KEY=
RS_API_TIMEOUT=10
RS_API_USERNAME=
RS_API_PASSWORD=
RS_API_AUTH_ENDPOINT=/authentication/create_token
RS_API_TOKEN_BUFFER=60

# RS MedInfras API
RS_MEDIN_ENDPOINT=/medinfrasapi/rsses
RS_MEDIN_API_CONSID=
RS_MEDIN_API_SECRETKEY=

# CMS API HMAC Credentials (Klien: Web Frontend)
# Digunakan untuk racikan X-Signature
CMS_API_CONSID_WEB=
CMS_API_SECRET_WEB=
CMS_API_TOLERANCE_MINUTES=5

# Web Frontend Webhook Invalidation (Zero-Delay Cache Invalidation)
# Kredensial WAJIB diisi dan TIDAK boleh sama dengan CMS_API_* di atas.
# Identitas di sini adalah identitas CMS sebagai pengirim (arah CMS -> Web).
WEB_FRONTEND_WEBHOOK_URL=http://172.17.12.17:2301/api/internal/webhook/cache-invalidate
WEB_FRONTEND_WEBHOOK_CONSID=
WEB_FRONTEND_WEBHOOK_SECRET=
WEB_FRONTEND_WEBHOOK_TIMEOUT=5

# Batasi domain yang bisa mengakses API (CORS)
# Contoh: https://latu.rs-elisabeth.com
CORS_ALLOWED_ORIGINS=*
MINIO_REGION=us-east-1
MINIO_BUCKET=
MINIO_ENDPOINT=
MINIO_URL_PUBLIC=
MINIO_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

WWWUSER=1000
WWWGROUP=1000
