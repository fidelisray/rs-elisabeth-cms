        "/api/v1/cms/forms": {
            "get": {
                "tags": [
                    "DynamicForms"
                ],
                "summary": "Get list of active published dynamic forms",
                "description": "Returns published dynamic forms currently active by schedule, optionally filtered by mode and lang.",
                "operationId": "f331bcf00fe6b67fd32427b4b1ffa6a4",
                "parameters": [
                    {
                        "name": "mode",
                        "in": "query",
                        "description": "Form mode: questionnaire or feedback",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "questionnaire",
                                "feedback"
                            ]
                        }
                    },
                    {
                        "name": "lang",
                        "in": "query",
                        "description": "Form language: id or en",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "id",
                                "en"
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation"
                    }
                },
                "security": [
                    {
                        "HmacAuth": []
                    }
                ]
            }
        },
        "/api/v1/cms/forms/{slug}": {
            "get": {
                "tags": [
                    "DynamicForms"
                ],
                "summary": "Get published dynamic form schema and availability",
                "description": "Returns published form schema snapshot, conditional logic, and live quota/schedule availability.",
                "operationId": "e6df540e88b89ffee9e21bf74ebe9773",
                "parameters": [
                    {
                        "name": "slug",
                        "in": "path",
                        "description": "Dynamic form slug",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation"
                    },
                    "404": {
                        "description": "Form not found or still draft"
                    }
                },
                "security": [
                    {
                        "HmacAuth": []
                    }
                ]
            }
        },
        "/api/v1/cms/forms/{slug}/submissions": {
            "post": {
                "tags": [
                    "DynamicForms"
                ],
                "summary": "Submit answers to a published dynamic form",
                "description": "Validates conditional visibility, section jumps, field rules, atomic quota, and upload_tokens, then stores the submission.",
                "operationId": "77c9c6265c9a8b29f7891216408a87d6",
                "parameters": [
                    {
                        "name": "slug",
                        "in": "path",
                        "description": "Dynamic form slug",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "answers"
                                ],
                                "properties": {
                                    "version_id": {
                                        "type": "integer",
                                        "nullable": true
                                    },
                                    "answers": {
                                        "type": "object"
                                    },
                                    "locale": {
                                        "type": "string",
                                        "nullable": true,
                                        "enum": [
                                            "id",
                                            "en"
                                        ]
                                    },
                                    "source": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "respondent_key": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "hp_website": {
                                        "type": "string",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Submission recorded"
                    },
                    "422": {
                        "description": "Validation or quota error"
                    },
                    "404": {
                        "description": "Form not found"
                    }
                },
                "security": [
                    {
                        "HmacAuth": []
                    }
                ]
            }
        },
        "/api/v1/cms/forms/{slug}/uploads": {
            "post": {
                "tags": [
                    "DynamicForms"
                ],
                "summary": "Step-1 private file upload for a dynamic form field",
                "description": "Validates MIME/extension/size against the published form schema and stores the file in private storage, returning a short-lived upload_token.",
                "operationId": "155a1e7a829e9ee0d6e36f33b6cf501a",
                "parameters": [
                    {
                        "name": "slug",
                        "in": "path",
                        "description": "Dynamic form slug",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "X-Content-SHA256",
                        "in": "header",
                        "description": "Hex SHA-256 hash of the uploaded file bytes; HMAC signs {timestamp}{consId}{X-Content-SHA256}",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "required": [
                                    "field_key",
                                    "file"
                                ],
                                "properties": {
                                    "field_key": {
                                        "type": "string"
                                    },
                                    "file": {
                                        "type": "string",
                                        "format": "binary"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "File uploaded"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "HmacAuth": []
                    }
                ]
            }
        },
