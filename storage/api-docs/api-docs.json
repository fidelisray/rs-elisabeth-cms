{
    "openapi": "3.0.0",
    "info": {
        "title": "RS Elisabeth CMS API",
        "description": "API documentation for RS Elisabeth CMS endpoints.",
        "version": "1.0.0"
    },
    "paths": {
        "/api/v1/cms/articles": {
            "get": {
                "tags": [
                    "Articles"
                ],
                "summary": "Get list of articles",
                "description": "Returns list of active articles with pagination.",
                "operationId": "9f8496e404284781234c7c68a358bc59",
                "responses": {
                    "200": {
                        "description": "Successful operation"
                    }
                },
                "security": [
                    {
                        "HmacAuth": []
                    }
                ]
            }
        },
        "/api/v1/cms/articles/{identifier}": {
            "get": {
                "tags": [
                    "Articles"
                ],
                "summary": "Get article detail",
                "description": "Returns an active article by numeric ID or by the exact slug in the selected locale. Slugs from other locales return 404. Use alternate_slugs to switch languages.",
                "operationId": "c2de3ba1a3a5686006c44878ae586302",
                "parameters": [
                    {
                        "name": "identifier",
                        "in": "path",
                        "description": "Article ID (numeric) or slug (string)",
                        "required": true
                    },
                    {
                        "name": "lang",
                        "in": "query",
                        "description": "Content locale: id or en. Unsupported values use id.",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "id",
                            "enum": [
                                "id",
                                "en"
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation"
                    },
                    "404": {
                        "description": "Resource Not Found"
                    }
                },
                "security": [
                    {
                        "HmacAuth": []
                    }
                ]
            }
        },
