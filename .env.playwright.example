# ==============================================================================
# Playwright E2E Environment Override (Optional — Lokal / Herd / Staging Smoke)
# ==============================================================================
#
# DEFAULT MODE (Disarankan untuk development & regression testing):
#   Biarkan file .env.playwright TIDAK dibuat. Menjalankan `npm run test:e2e`
#   akan otomatis membuat database terisolasi (`database/e2e.sqlite`), menjalankan
#   server Laravel khusus di http://127.0.0.1:8010 dengan MEDIA_DISK=public dan
#   RS_API_ENABLED=false, serta membersihkan diri tanpa menyentuh DB lokal.
#
# OVERRIDE MODE (Smoke test ke Laravel Herd atau Docker Staging):
#   Salin file ini menjadi `.env.playwright` (sudah di-gitignore) dan isi
#   PLAYWRIGHT_BASE_URL serta kredensial akun uji yang sudah ada di target.
#   Mode override TIDAK menjalankan bootstrap reset database.

# PLAYWRIGHT_BASE_URL=http://rs-elisabeth-cms.test
# PLAYWRIGHT_SUPER_ADMIN_EMAIL=admin@rs-elisabeth.com
# PLAYWRIGHT_SUPER_ADMIN_PASSWORD=
# PLAYWRIGHT_MARKETING_EMAIL=
# PLAYWRIGHT_MARKETING_PASSWORD=
# PLAYWRIGHT_STAFF_IT_EMAIL=
# PLAYWRIGHT_STAFF_IT_PASSWORD=

# Opsional: path eksplisit binary PHP jika tidak berada di PATH default
# PLAYWRIGHT_PHP_BIN=php
